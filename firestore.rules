rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is logged in
    function isSignedIn() {
      return request.auth != null;
    }

    // Helper to check user document data in 'users' collection
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Helper to check if authorized Admin/Owner
    function isAdmin() {
      return isSignedIn() && (
        (
          exists(/databases/$(database)/documents/admins/$(request.auth.uid)) && 
          (!('isActive' in get(/databases/$(database)/documents/admins/$(request.auth.uid)).data) || 
           get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.isActive == true)
        ) || (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          (getUserData().role in ['admin', 'founder', 'super_admin'])
        ) || (
          exists(/databases/$(database)/documents/staff/$(request.auth.uid)) &&
          (get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.role in ['admin', 'super_admin'] &&
           get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.status == 'active')
        ) || (
          request.auth.token.email == 'sarkarmdanik14@gmail.com'
        )
      );
    }

    // Helper to check if authorized Staff member
    function isStaff() {
      return isSignedIn() && (
        (exists(/databases/$(database)/documents/staff/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.status == 'active') ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         getUserData().role in ['admin', 'super_admin', 'order_manager', 'product_manager', 'call_center_agent', 'customer_support', 'delivery_manager', 'accounts_manager']) ||
        isAdmin()
      );
    }

    // Helper to check if seller
    function isSeller() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/sellers/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (getUserData().role in ['seller', 'admin', 'founder']))
      );
    }

    // Helper to check if rider
    function isRider() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/riders/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (getUserData().role in ['rider', 'admin', 'founder']))
      );
    }

    // Helper to verify if user owns a specific partner shop
    function isShopOwner(shopId) {
      return isSignedIn() && shopId != null && exists(/databases/$(database)/documents/partner_shops/$(shopId)) && (
        get(/databases/$(database)/documents/partner_shops/$(shopId)).data.ownerUid == request.auth.uid ||
        get(/databases/$(database)/documents/partner_shops/$(shopId)).data.email == request.auth.token.email
      );
    }

    // Global Safety Net default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Categories - Publicly viewable catalog for browsing, managed strictly by Admin
    match /categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Partner Shops - Viewable by catalog visitors, managed by Admin and shop owners
    match /partner_shops/{shopId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (isSignedIn() && (
        resource.data.ownerUid == request.auth.uid ||
        resource.data.email == request.auth.token.email
      ));
    }

    // Products - Publicly viewable catalog for browsing, managed strictly by Admin, authorized Staff, verified Sellers & Partners
    match /products/{productId} {
      allow read: if true;
      allow create: if isAdmin() || isStaff() || 
        (isSeller() && request.resource.data.sellerId == request.auth.uid) ||
        (isSignedIn() && isShopOwner(request.resource.data.partnerShopId));
      allow update: if isAdmin() || isStaff() || 
        (isSeller() && resource.data.sellerId == request.auth.uid) ||
        (isSignedIn() && isShopOwner(resource.data.partnerShopId));
      allow delete: if isAdmin() || isStaff() || 
        (isSeller() && resource.data.sellerId == request.auth.uid) ||
        (isSignedIn() && isShopOwner(resource.data.partnerShopId));
    }

    // Orders - Customers access ONLY their own orders. Staff, Admins & Partners access according to verified role
    match /orders/{orderId} {
      allow read: if isAdmin() || isStaff() || (isSignedIn() && (
        resource.data.customerId == request.auth.uid || 
        (resource.data.customerEmail != null && resource.data.customerEmail == request.auth.token.email) ||
        (resource.data.customerPhone != null && request.auth.token.phone_number != null && resource.data.customerPhone == request.auth.token.phone_number) ||
        resource.data.riderId == request.auth.uid || 
        resource.data.sellerId == request.auth.uid ||
        resource.data.partnerShopId == request.auth.uid ||
        (resource.data.partnerShopIds != null && request.auth.uid in resource.data.partnerShopIds) ||
        isShopOwner(resource.data.partnerShopId)
      ));
      // Guests can place orders with required fields; signed-in users cannot spoof customerId
      allow create: if (
        (!isSignedIn() && request.resource.data.keys().hasAll(['id', 'items', 'total', 'customerPhone'])) ||
        (isSignedIn() && (
          !('customerId' in request.resource.data) || 
          request.resource.data.customerId == request.auth.uid
        ))
      );
      // Hardened updates: customers can only cancel or request refunds; riders can accept/deliver; admin/staff full management
      allow update: if isAdmin() || isStaff() || (isSignedIn() && (
        (
          resource.data.customerId == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['orderStatus', 'refundReason', 'notes', 'cancellationReason', 'updatedAt']) &&
          (!('paymentStatus' in request.resource.data) || request.resource.data.paymentStatus == resource.data.paymentStatus) &&
          (!('total' in request.resource.data) || request.resource.data.total == resource.data.total)
        ) ||
        (
          resource.data.riderId == request.auth.uid && (
            !('paymentStatus' in request.resource.data) ||
            request.resource.data.paymentStatus == "paid" ||
            request.resource.data.paymentStatus == resource.data.paymentStatus
          )
        ) ||
        (
          resource.data.sellerId == request.auth.uid && (
            !('paymentStatus' in request.resource.data) ||
            request.resource.data.paymentStatus == resource.data.paymentStatus
          )
        ) ||
        (
          isShopOwner(resource.data.partnerShopId)
        )
      ));
      allow delete: if isAdmin();
    }

    // Users (Customers, Sellers, Riders profiles) - Customers access ONLY their own profile data
    match /users/{userId} {
      allow read: if isAdmin() || isStaff() || (isSignedIn() && request.auth.uid == userId);
      allow create: if isSignedIn() && request.auth.uid == userId && (
        (!('role' in request.resource.data) || request.resource.data.role == 'customer') &&
        (!('status' in request.resource.data) || request.resource.data.status == 'active' || request.resource.data.status == 'pending') &&
        (!('isSuperAdmin' in request.resource.data) || request.resource.data.isSuperAdmin == false)
      );
      allow update: if isAdmin() || (isSignedIn() && request.auth.uid == userId && (
        (!('status' in request.resource.data) || request.resource.data.status == resource.data.status) &&
        (!('sellerStatus' in request.resource.data) || request.resource.data.sellerStatus == resource.data.sellerStatus) &&
        (!('riderStatus' in request.resource.data) || request.resource.data.riderStatus == resource.data.riderStatus) &&
        (!('role' in request.resource.data) || request.resource.data.role == resource.data.role) &&
        (!('isSuperAdmin' in request.resource.data) || request.resource.data.isSuperAdmin == resource.data.isSuperAdmin) &&
        (!('balance' in request.resource.data) || request.resource.data.balance == resource.data.balance) &&
        (!('wallet' in request.resource.data) || request.resource.data.wallet == resource.data.wallet)
      ));
      allow delete: if isAdmin();
    }

    // Carts (Cloud-synced user carts) - Users access ONLY their own cart
    match /carts/{cartId} {
      allow read, write: if isAdmin() || (isSignedIn() && request.auth.uid == cartId);
    }

    // Admins collection - strictly read-only for verified admin user, immutable via client
    match /admins/{adminId} {
      allow read: if isSignedIn() && (request.auth.uid == adminId || isAdmin());
      allow write: if false; // Only manageable via Firebase Console or Firebase Admin SDK
    }

    // Sellers collection - Public shop viewable, private details restricted
    match /sellers/{sellerId} {
      allow read: if true; // Public shop details viewable
      allow create: if isSignedIn() && request.auth.uid == sellerId && (
        !('status' in request.resource.data) || request.resource.data.status == 'pending'
      );
      allow update: if isAdmin() || (isSignedIn() && request.auth.uid == sellerId && (
        (!('status' in request.resource.data) || request.resource.data.status == resource.data.status)
      ));
      allow delete: if isAdmin();
    }

    // Riders collection - Riders access ONLY their own rider document
    match /riders/{riderId} {
      allow read: if isAdmin() || isStaff() || (isSignedIn() && request.auth.uid == riderId);
      allow create: if isSignedIn() && request.auth.uid == riderId && (
        !('status' in request.resource.data) || request.resource.data.status == 'pending'
      );
      allow update: if isAdmin() || (isSignedIn() && request.auth.uid == riderId && (
        (!('status' in request.resource.data) || request.resource.data.status == resource.data.status)
      ));
      allow delete: if isAdmin();
    }

    // Payments - Sensitive payment data accessible ONLY by owner and Admin
    match /payments/{paymentId} {
      allow read: if isAdmin() || isStaff() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if (isSignedIn() && request.resource.data.userId == request.auth.uid) || isAdmin() || (request.resource.data.orderId != null && request.resource.data.amount > 0);
      allow update, delete: if isAdmin();
    }

    // Wallet - Users cannot tamper with balances. Initial bonus (0 or 50) permitted on create.
    match /wallet/{walletId} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == walletId);
      allow create: if (isSignedIn() && request.auth.uid == walletId && (
        !('balance' in request.resource.data) || request.resource.data.balance in [0, 50]
      )) || isAdmin();
      allow update: if isAdmin() || (
        isRider() && 
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['balance', 'updatedAt']) && 
        request.resource.data.balance == resource.data.balance + 50
      );
      allow delete: if false;
    }

    // Transactions - Users access ONLY their own transactions, immutable
    match /transactions/{transactionId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && (
        request.resource.data.userId == request.auth.uid || 
        isRider() || 
        isAdmin()
      );
      allow update, delete: if isAdmin();
    }

    // Coupons - Publicly readable for checkout validation, managed strictly by Admin
    match /coupons/{couponId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Flash Sales - Publicly readable for store display, managed strictly by Admin
    match /flash_sales/{saleId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Referrals - Users access ONLY their own referrals
    match /referrals/{referralId} {
      allow read: if isAdmin() || (isSignedIn() && (
        resource.data.referrerId == request.auth.uid || 
        resource.data.referredId == request.auth.uid
      ));
      allow create: if isSignedIn() && (
        request.resource.data.referredId == request.auth.uid
      );
      allow update: if isAdmin() || isRider() || (isSignedIn() && (
        resource.data.referrerId == request.auth.uid || 
        resource.data.referredId == request.auth.uid
      ));
      allow delete: if isAdmin();
    }

    // Reviews - Publicly viewable, authenticated users create their own reviews, Admin manages all
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // Notifications - Users access their own notifications or system broadcasts ("all"). Admin notices restricted to Admin.
    match /notifications/{notificationId} {
      allow read: if isAdmin() || (isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        resource.data.userId == "all"
      ));
      allow create: if request.resource.data.userId == "admin-default" || request.resource.data.userId == "all" || (isSignedIn() && (
        request.resource.data.userId == request.auth.uid ||
        isRider() ||
        isAdmin()
      ));
      allow update, delete: if isAdmin();
    }

    // Banners - Publicly viewable for carousel, managed strictly by Admin
    match /banners/{bannerId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Settings - Publicly viewable for store configuration, managed strictly by Admin
    match /settings/{settingId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Memo Audit Logs - Strictly readable & creatable for tracking, immutable
    match /memo_audit_logs/{logId} {
      allow read: if isAdmin() || isStaff();
      allow create: if isSignedIn() || isAdmin();
      allow update, delete: if false;
    }

    // Chats - Support chat sessions accessible ONLY to chat owner and Admin/Staff
    match /chats/{chatId} {
      allow read: if isAdmin() || isStaff() || (isSignedIn() && (
        resource.data.userId == request.auth.uid || 
        resource.data.customerId == request.auth.uid || 
        chatId == request.auth.uid
      ));
      allow create: if isAdmin() || isStaff() || (isSignedIn() && (
        request.resource.data.userId == request.auth.uid || 
        request.resource.data.customerId == request.auth.uid || 
        chatId == request.auth.uid
      )) || (chatId != null && request.resource.data.chatId == chatId);
      allow update: if isAdmin() || isStaff() || (isSignedIn() && (
        resource.data.userId == request.auth.uid || 
        resource.data.customerId == request.auth.uid || 
        chatId == request.auth.uid
      ));
      allow delete: if isAdmin();
    }

    // Chat messages - Messages accessible ONLY to conversation participants and Admin/Staff
    match /chat_messages/{messageId} {
      allow read: if isAdmin() || isStaff() || (isSignedIn() && (
        resource.data.senderId == request.auth.uid || 
        resource.data.recipientId == request.auth.uid || 
        resource.data.userId == request.auth.uid || 
        resource.data.chatId == request.auth.uid
      ));
      allow create: if isAdmin() || isStaff() || (isSignedIn() && (
        request.resource.data.senderId == request.auth.uid || 
        request.resource.data.userId == request.auth.uid
      )) || (request.resource.data.chatId != null && request.resource.data.text != null && request.resource.data.text.size() <= 2000);
      allow update, delete: if isAdmin();
    }

    // WebRTC Voice Calls & Signaling - Accessible ONLY to call participants and Admin/Staff
    match /voice_calls/{callId} {
      allow read: if isAdmin() || isStaff() || (isSignedIn() && (
        resource.data.callerId == request.auth.uid || 
        resource.data.calleeId == request.auth.uid || 
        resource.data.customerId == request.auth.uid
      ));
      allow create, update: if isAdmin() || isStaff() || (isSignedIn() && (
        request.resource.data.callerId == request.auth.uid || 
        request.resource.data.calleeId == request.auth.uid || 
        request.resource.data.customerId == request.auth.uid
      ));
      allow delete: if isAdmin() || isStaff();

      match /callerCandidates/{candidateId} {
        allow read, write: if isAdmin() || isStaff() || isSignedIn();
      }
      match /calleeCandidates/{candidateId} {
        allow read, write: if isAdmin() || isStaff() || isSignedIn();
      }
    }

    // Call Center 20 Agent desks roster and status - Modifiable ONLY by Staff and Admin
    match /call_center_agents/{agentId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || (isSignedIn() && isStaff());
    }

    // Staff Members Collection - Restricted strictly to Admin/Staff (NO public access)
    match /staff/{staffId} {
      allow read: if isAdmin() || (isSignedIn() && (request.auth.uid == staffId || isStaff()));
      allow create: if isAdmin() || (isSignedIn() && request.auth.token.email == 'sarkarmdanik14@gmail.com');
      allow update: if (isAdmin() || (isSignedIn() && request.auth.token.email == 'sarkarmdanik14@gmail.com')) && (
        // Protect super admin role escalation: normal admins cannot escalate anyone to super_admin or change founder's role
        (!('role' in request.resource.data) || request.resource.data.role != 'super_admin' || (
          resource != null && resource.data.role == 'super_admin'
        ) || request.auth.token.email == 'sarkarmdanik14@gmail.com') &&
        (!('isSuperAdmin' in request.resource.data) || request.resource.data.isSuperAdmin != true || (
          resource != null && resource.data.isSuperAdmin == true
        ) || request.auth.token.email == 'sarkarmdanik14@gmail.com')
      );
      // Strictly prevent deleting the founder/super_admin
      allow delete: if (isAdmin() || (isSignedIn() && request.auth.token.email == 'sarkarmdanik14@gmail.com')) && (
        resource == null || (
          resource.data.role != 'super_admin' && 
          resource.data.isSuperAdmin != true &&
          resource.data.email != 'sarkarmdanik14@gmail.com'
        )
      );
    }

    // Staff Activity Logs - Immutable Audit Trail accessible ONLY to Admin and Staff
    match /staff_activity_logs/{logId} {
      allow read: if isAdmin() || isStaff();
      allow create: if isAdmin() || isStaff();
      allow update, delete: if false; // Immutable audit trail
    }

    // Visitor Analytics - Sessions & Real-time Live Tracking
    match /visitor_sessions/{visitorId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if true;
    }

    // Daily Analytics Aggregation (Today's views and unique visitors)
    match /analytics_daily/{dateId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if true;
    }
  }
}
