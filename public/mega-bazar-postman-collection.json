  "item": [
    {
      "name": "System & Health",
      "item": [
        {
          "name": "Server Health Check",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": ["{{baseUrl}}"],
              "path": ["api", "health"]
            }
          }
        },
        {
          "name": "Cloudflare R2 Status",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/r2/status",
              "host": ["{{baseUrl}}"],
              "path": ["api", "r2", "status"]
            }
          }
        }
      ]
    },
    {
      "name": "Authentication & Staff",
      "item": [
        {
          "name": "Login Verification (Staff & OTP Users)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identifier\": \"sarkarmdanik14@gmail.com\",\n  \"password\": \"your_password\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login-verify",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login-verify"]
            }
          }
        },
        {
          "name": "Exchange Supabase Token for Staff Session",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"accessToken\": \"{{supabaseToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/staff/supabase-session",
              "host": ["{{baseUrl}}"],
              "path": ["api", "staff", "supabase-session"]
            }
          }
        },
        {
          "name": "Get Active Staff Session",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{staffSessionId}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/staff/active-session",
              "host": ["{{baseUrl}}"],
              "path": ["api", "staff", "active-session"]
            }
          }
        },
        {
          "name": "Logout Session",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{staffSessionId}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sessionId\": \"{{staffSessionId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "logout"]
            }
          }
        }
      ]
    },
    {
